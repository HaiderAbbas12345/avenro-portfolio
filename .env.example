# Public URL of the production site (no trailing slash). Used for canonical
# URLs, sitemap, RSS and Open Graph.
NEXT_PUBLIC_SITE_URL=https://avenro.com

# Contact form delivery (server-only, never exposed to the browser).
# Uses the Resend HTTP API: https://resend.com
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL="Avenro Website <website@avenro.com>"
CONTACT_TO_EMAIL=hello@avenro.com

# Search engine ownership verification (optional; DNS verification also works).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
